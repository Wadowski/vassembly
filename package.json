{
  "name": "vassembly",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "NODE_OPTIONS='--max-old-space-size=1024' dotenv -- turbo run dev",
    "dev:env": "NODE_OPTIONS='--max-old-space-size=1024' bash -c 'set -a && source .env.e2e.example && set +a && turbo run dev'",
    "lint": "turbo run lint",
    "storybook": "cd ui/storybook && pnpm storybook",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:web": "turbo run test:e2e --filter=@vassembly/web",
    "test:e2e:api": "turbo run test:e2e --filter=@vassembly/api",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.8.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@vassembly/ui-checkbox": "workspace:^",
    "@vassembly/ui-register-form": "link:ui/components/register-form"
  }
}
