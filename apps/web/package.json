{
  "name": "@vassembly/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "bddgen": "NODE_OPTIONS='--require ./e2e/loadE2eEnv.cjs' node -r tsx/cjs node_modules/playwright-bdd/dist/cli/index.js",
    "test:e2e": "NODE_OPTIONS='--max-old-space-size=8192' node ./e2e/scripts/runBddgenIfNeeded.cjs && playwright test",
    "test:e2e:ci": "NODE_OPTIONS='--max-old-space-size=8192' node ./e2e/scripts/runBddgenIfNeeded.cjs && playwright test --grep-invert @slow",
    "test:e2e:ui": "NODE_OPTIONS='--max-old-space-size=8192' node ./e2e/scripts/runBddgenIfNeeded.cjs && playwright test --ui",
    "test:e2e:headed": "NODE_OPTIONS='--max-old-space-size=8192' node ./e2e/scripts/runBddgenIfNeeded.cjs && playwright test --headed",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vassembly/config": "workspace:*",
    "@vassembly/constants": "workspace:*",
    "@vassembly/errors": "workspace:*",
    "@vassembly/ui-api-hooks": "workspace:*",
    "@vassembly/ui-drawer-navigation": "workspace:*",
    "@vassembly/ui-execution-progress-tracker": "workspace:*",
    "@vassembly/ui-forgot-password": "workspace:*",
    "@vassembly/ui-layout": "workspace:*",
    "@vassembly/ui-login-form": "workspace:*",
    "@vassembly/ui-register-form": "workspace:*",
    "@vassembly/ui-reset-password-form": "workspace:*",
    "@vassembly/ui-system-design": "workspace:*",
    "@vassembly/ui-user-auth": "workspace:*",
    "@vassembly/validation": "workspace:*",
    "lottie-react": "^2.4.1",
    "next": "16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/env": "16.1.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vassembly/e2e": "workspace:*",
    "@vassembly/eslint-config": "workspace:*",
    "@vassembly/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "20",
    "playwright": "^1.55.0",
    "playwright-bdd": "^9.1.0",
    "sass": "^1.86.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "vitest": "^2.0.0"
  }
}
