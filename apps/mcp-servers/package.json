{
  "name": "@vassembly/mcp-servers",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "up": "docker compose -f docker-compose.yml -f docker-compose.override.yml up -d --build",
    "up:full": "docker compose -f docker-compose.yml -f docker-compose.override.yml --profile full up -d --build",
    "down": "docker compose -f docker-compose.yml -f docker-compose.override.yml down",
    "logs": "docker compose -f docker-compose.yml -f docker-compose.override.yml logs -f"
  }
}
