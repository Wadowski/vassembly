{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "globalDependencies": [
    ".env",
    ".env.e2e",
    "**/vitest.config.ts",
    "**/playwright.config.ts"
  ],
  "globalEnv": [
    "CI",
    "AUTH_PASSWORD_RESET_WEB_URL",
    "EMAIL_VERIFICATION_WEB_URL",
    "CACHE_BACKEND",
    "CACHE_DEFAULT_TTL_MS",
    "REDIS_URL",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_REGION",
    "DEEP_SEEK_AI_API_KEY",
    "DEEP_SEEK_AI_BASE_URL",
    "PLATFORM_AI_PROVIDER",
    "PLATFORM_AI_API_KEY",
    "PLATFORM_AI_BASE_URL",
    "PLATFORM_AI_DEFAULT_MODEL",
    "PLATFORM_AI_ORGANIZATION_ID",
    "ENCODER_SECRET",
    "MONGODB_URL",
    "MONGODB_DATABASE",
    "JWT_SECRET",
    "SKILL_SCRIPT_STORAGE_BUCKET",
    "SKILL_SCRIPT_STORAGE_LOCAL_PATH",
    "SKILLS_EXECUTION_BACKEND",
    "SKILLS_EXECUTION_STDOUT_MAX_BYTES",
    "SKILLS_EXECUTION_STDERR_MAX_BYTES",
    "SKILLS_EXECUTION_MEMORY_LIMIT_MB",
    "SKILLS_EXECUTION_WORKER_URL",
    "SKILLS_EXECUTION_CLOUD_WORKER_URL",
    "SKILLS_EXECUTION_CLOUD_API_KEY",
    "SKILLS_EXECUTION_WARM_POOL_SIZE",
    "MCP_HOST",
    "MCP_LOG_LEVEL",
    "MCP_PROXY_POOL_SIZE",
    "MCP_SERVER_URLS_JSON"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "MONGODB_URL",
        "MONGODB_DATABASE",
    "JWT_SECRET",
    "VASSEMBLY_E2E",
    "WEB_PORT",
    "API_PORT",
    "DOCS_PORT",
    "E2E_WEB_BASE_URL",
        "E2E_API_BASE_URL",
        "NODE_ENV"
      ]
    },
    "test:e2e:ci": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "MONGODB_URL",
        "MONGODB_DATABASE",
        "JWT_SECRET",
        "VASSEMBLY_E2E",
        "WEB_PORT",
        "API_PORT",
        "DOCS_PORT",
        "E2E_WEB_BASE_URL",
        "E2E_API_BASE_URL",
        "NODE_ENV",
        "E2E_ENABLE_DIAGNOSTICS"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
