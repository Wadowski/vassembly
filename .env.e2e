# MongoDB
MONGODB_URL=mongodb://user:pass@localhost:27017/?directConnection=true
MONGODB_DATABASE=vassembly_e2e

# JWT & Auth
JWT_SECRET=dev-jwt-secret

# App ports (must match packages/config/src/e2e.ts)
WEB_PORT=3001
API_PORT=5001
DOCS_PORT=3002

# Web App
E2E_WEB_BASE_URL=http://localhost:3001

# API Gateway
E2E_API_BASE_URL=http://localhost:5001
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001

# Test Environment
NODE_ENV=e2e
VASSEMBLY_E2E=true
E2E_REQUEST_LOOP_THRESHOLD=30
NEXT_PRIVATE_DISABLE_DEV_OVERLAY_UX=1

# Skill script storage (relative to each package cwd: apps/api, apps/web)
SKILL_SCRIPT_STORAGE_LOCAL_PATH=../../.data/skill-scripts
